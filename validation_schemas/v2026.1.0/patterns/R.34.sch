<?xml version="1.0" encoding="UTF-8"?>
<pattern xmlns="http://purl.oclc.org/dsdl/schematron"
    id="R.34"
    is-a="reden-niet-verwijdering-ingevuld">
    <param name="rule_number" value="34"/>
    <param name="scope" value="ma:scope-name(.)"/>
    <param name="severity" value="ma:rule-severity-within-scope(34, .)"/>
    <param name="object_type" value="name(.)"/>
    <param name="object_id" value="nlcs:ID"/>
</pattern>
