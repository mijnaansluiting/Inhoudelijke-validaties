<?xml version="1.0" encoding="UTF-8"?>
<pattern xmlns="http://purl.oclc.org/dsdl/schematron"
         id="R.33"
         is-a="aanwezigheid-bestand-bijlage-aanlegtechniek">
    <param name="rule_number" value="33"/>
    <param name="scope" value="ma:scope-name(.)"/>
    <param name="severity" value="ma:rule-severity-within-scope(33, .)"/>
    <param name="object_type" value="name(.)"/>
    <param name="object_id" value="nlcs:ID"/>
</pattern>
