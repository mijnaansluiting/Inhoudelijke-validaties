<?xml version="1.0" encoding="UTF-8"?>
<pattern xmlns="http://purl.oclc.org/dsdl/schematron"
    id="R.35"
    is-a="aanwezigheid-maaiveldhoogte">
    <param name="rule_number" value="35"/>
    <param name="scope" value="ma:scope-name(.)"/>
    <param name="severity" value="ma:rule-severity-within-scope(35, .)"/>
    <param name="object_type" value="name(.)"/>
    <param name="object_id" value="nlcs:ID"/>
</pattern>
